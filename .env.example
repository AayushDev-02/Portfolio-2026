# Stage 6 — contact system. Copy to .env.local and fill in.
# Never commit .env.local. Set the same values in Vercel > Settings > Environment Variables.
#
# NAMING RULE: only NEXT_PUBLIC_SITE_URL carries the public prefix, because it is
# a public URL and nothing else. Everything below it is server-only.
#
# The browser never talks to Supabase in this project. Contact submissions go
# through a Next.js server action, which holds the service role key. That means
# NO Supabase variable needs — or may have — a NEXT_PUBLIC_ prefix. The service
# role key in particular bypasses Row Level Security entirely; with a public
# prefix it is inlined into the client bundle and hands anyone on the internet
# full read/write access to the database.

# Resend (https://resend.com) — email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase (https://supabase.com) — submission storage. Server-only, both of them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (https://upstash.com) — rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for metadata/canonical/sitemap.
# Legitimately public — it is the address of the site itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
